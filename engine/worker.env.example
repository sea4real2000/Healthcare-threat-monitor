# Settings for the background service in docker-compose.worker.yml.
# Copy this file to worker.env in the same folder and fill in each value. worker.env is ignored by git.

# The Supabase connection string, Transaction pooler, with ?sslmode=require on the end.
DATABASE_URL=

# The console's Vercel address, with no trailing slash. For example https://your-project.vercel.app
HTM_API_URL=

# Printed by: npm run collector:key -- sim_hospital_01   (in the web folder, with INGEST_SIGNING_KEY set to the Vercel value)
HTM_COLLECTOR_SECRET=

# The same value as SIEM_WEBHOOK_KEY on Vercel.
SIEM_WEBHOOK_KEY=
