# Copy this file to .env.local inside the web folder for local work.
# On Vercel and on the Python host, set these as environment variables instead.
# Never commit real values. Generate each secret with: openssl rand -hex 32

# ---- Console and APIs (web folder, Vercel) ----

# Postgres connection string. In Supabase: Project Settings, Database, Connection string,
# Transaction pooler. Keep the password out of the repository.
DATABASE_URL=

# Optional. "require" or "disable". Left empty, TLS is required for every host except localhost.
DATABASE_SSL=

# Server key that every collector secret is derived from. At least 32 characters.
INGEST_SIGNING_KEY=

# Protects sign in: seals each account's authenticator secret. At least 32 characters.
# Changing it later means every account must set up its authenticator app again.
AUTH_SECRET=

# Shared by the console and the background service. Signs the SIEM webhook
# and lets the built in receiver check it. At least 32 characters.
SIEM_WEBHOOK_KEY=

# Optional. Signs audit log exports. At least 32 characters.
AUDIT_EXPORT_KEY=

# Optional. Seals the passwords of connected records databases. At least 32 characters.
# Needed by both the console and the background service, with the same value, to connect a records database.
# Changing it later means every connection's password must be entered again.
SOURCES_SECRET=

# Optional. Where the console reads its installation's own root certificate, to put in Windows collector installers
# so each computer trusts that authority and nothing else. docker-compose.hospital.yml sets it. Leave it empty when
# the console has a certificate from a public authority, as on Vercel.
HTM_TRUST_URL=

# Optional. Sends invitation emails through Resend. The sending domain must be verified with Resend,
# and the sender address is set in the console under Settings, Email.
RESEND_API_KEY=

# Optional. Unlocks the detailed report at /api/health?diagnose=1. At least 24 characters.
DIAGNOSE_TOKEN=

# ---- Background service (engine folder, Python host) ----

# The same database as the console.
# DATABASE_URL=

# The same value as the console.
# SIEM_WEBHOOK_KEY=
# SOURCES_SECRET=

# Base address of the deployed console, with no trailing slash.
HTM_API_URL=

# The collector the service signs as. Must exist in the collectors table.
HTM_COLLECTOR_ID=sim_hospital_01

# Printed by: npm run collector:key -- sim_hospital_01 (run in the web folder with INGEST_SIGNING_KEY set)
HTM_COLLECTOR_SECRET=

# Optional. Folder of CICIoMT2024 feature CSV files, to shape device attack traffic from the dataset.
HTM_DEVICE_DATASET=

# ---- Webhook connector (engine folder, only when acting on real endpoints) ----

# The collector the connector signs as, and its secret from: npm run collector:key -- endpoint_webhook_01
HTM_CONNECTOR_ID=endpoint_webhook_01
HTM_CONNECTOR_SECRET=

# Where each approved isolation or release is posted.
CONNECTOR_TARGET_URL=

# Optional. Signs each post, and sets an Authorization header for the target.
CONNECTOR_TARGET_KEY=
CONNECTOR_TARGET_AUTH=
