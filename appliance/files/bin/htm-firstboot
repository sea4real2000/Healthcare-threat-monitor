#!/bin/bash
# Healthcare Threat Monitor appliance: prepares a new copy once, on its first start.
# Grows the system to fill the disk it was given, and loads the platform's software into Docker.
# Safe to stop at any point, for example by switching the computer off: it carries on from where it was
# on the next start, and a part that failed to load is tried again.
set -uo pipefail
mkdir -p /var/lib/htm
# Each step goes to the system log, to the computer's own screen through /run/htm-status, and to the serial
# console of a computer that has one.
log() { echo "htm-firstboot: $*"; if [ -c /dev/ttyS0 ]; then echo "htm-firstboot: $*" > /dev/ttyS0 2>/dev/null || true; fi; }
status() { echo "$*" > /run/htm-status; log "$*"; }

root=$(findmnt -no SOURCE /)
# The disk and partition number, from the kernel's own description of the device.
dev=$(basename "$(readlink -f "$root")")
part=$(cat "/sys/class/block/$dev/partition")
disk=/dev/$(basename "$(readlink -f "/sys/class/block/$dev/..")")
status "Making room on the disk."
# The disk may be larger than the image: fix the partition table's end marker, then grow the system.
sgdisk -e "$disk" >/dev/null 2>&1 || true
if out=$(growpart "$disk" "$part" 2>&1); then
  log "grew partition $part on $disk"
else
  case "$out" in *NOCHANGE*) log "partition $part already fills $disk" ;; *) log "could not grow partition $part on $disk: $out" ;; esac
fi
if resize2fs "$root" >/dev/null 2>&1; then log "file system fills the partition: $(df -h --output=size / | tail -1 | tr -d ' ')"; else log "could not grow the file system"; fi

# The image files stay on the disk, so a damaged Docker store can always be rebuilt from them. A marker per part
# records what Docker already has, so a first start that was switched off carries on where it was.
mkdir -p /var/lib/htm/loaded
mapfile -t files < <(ls /opt/htm/images/*.tar.zst 2>/dev/null)
total=${#files[@]}
i=0
for f in "${files[@]}"; do
  i=$((i + 1))
  name=$(basename "$f")
  [ -f "/var/lib/htm/loaded/$name" ] && continue
  loaded=no
  for attempt in 1 2 3; do
    status "Loading the platform's software, part $i of $total. Each part can take several minutes."
    log "loading $name, attempt $attempt"
    if zstd -dc "$f" | docker load >/dev/null; then loaded=yes; break; fi
    log "loading $name failed, trying again"
    sleep 10
  done
  if [ "$loaded" != yes ]; then
    status "Could not load part $i of $total. Restart this computer to try again."
    exit 1
  fi
  touch "/var/lib/htm/loaded/$name"
done

# Every image the platform needs must now be in Docker, however the loading went.
missing=""
while read -r image; do
  [ -n "$image" ] || continue
  docker image inspect "$image" >/dev/null 2>&1 || missing="$missing $image"
done < /opt/htm/images.list
if [ -n "$missing" ]; then
  log "missing after loading:$missing"
  status "Some of the platform's software is missing. Restart this computer to try again."
  exit 1
fi
touch /var/lib/htm/firstboot-done
status "Prepared."
log "ready"
