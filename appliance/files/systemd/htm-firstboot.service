[Unit]
Description=Healthcare Threat Monitor: prepare a new copy for first use
After=docker.service local-fs.target
Requires=docker.service
ConditionPathExists=!/var/lib/htm/firstboot-done
ConditionPathExists=!/etc/htm/installer

[Service]
Type=oneshot
ExecStart=/opt/htm/bin/htm-firstboot
RemainAfterExit=yes
# A slow computer can take a long time over the first start. It is never cut short, and tried again on failure.
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
